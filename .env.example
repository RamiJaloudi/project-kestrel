# Copy structure only. START points at .env; prepare_demo_env generates local secrets.
KESTREL_ENV=LOCAL
# KESTREL_DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST:PORT/kestrel"
# KESTREL_DB_HOST="127.0.0.1"
# KESTREL_DB_PORT="55432"
# KESTREL_DB_NAME="kestrel"
# KESTREL_DB_USER="kestrel_local"
# KESTREL_DB_PASSWORD="GENERATE_LOCALLY"
KESTREL_CHRIS_EMAIL="chris.madden@freshfields.example"
KESTREL_SUMEET_EMAIL="sumeet.josh_external@freshfields.example"
# KESTREL_INTERVIEW_PASSWORD="GENERATE_LOCALLY_SHARED_SYNTHETIC_DEMO_PASSWORD"
KESTREL_PROVISION_INTERVIEW_ACCOUNTS=true
# Three accounts per supported role plus named clean-team members, local synthetic only.
# KESTREL_DUMMY_PASSWORD="SET_SHARED_LOCAL_DEMO_PASSWORD"
KESTREL_PROVISION_DUMMY_ACCOUNTS=true

KESTREL_RAMI_EMAIL="rami.jaloudi@freshfields.example"
KESTREL_SEED_DOCUMENT_DEMO=true
# Live personal synthetic processing: disabled until a key and processing policy are configured.
KESTREL_OPENAI_ENABLED=false
# KESTREL_OPENAI_API_KEY="SET_PRIVATELY"
# Application limits are fixed at USD 2/run and USD 10/month.

# Optional local bundled workbook engine paths (no API keys).
KESTREL_ARTIFACT_NODE=
KESTREL_ARTIFACT_MODULES=
